# Knowledge and answer libraries: 100% line and branch coverage, including
# crawler, durable jobs and both stores. Full measurement requires PostgreSQL.
# The CLI and the web page are deliverable surfaces and are measured to the
# same target: they are the two ways a person actually reaches this system.
# Only the package docstring module is omitted, having no behaviour to measure.

[run]
branch = True
source = assistant
omit =
    assistant/__init__.py

[report]
show_missing = True
skip_covered = False
exclude_lines =
    pragma: no cover
    raise NotImplementedError
    if __name__ == .__main__.:
    \.\.\.$
