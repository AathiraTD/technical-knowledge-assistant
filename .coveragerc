# Knowledge and answer libraries: 100% line and branch coverage, including
# crawler, durable jobs and both stores. Full measurement requires PostgreSQL.
# CLI/UI presentation wrappers are outside this library coverage target.

[run]
branch = True
source = assistant
omit =
    assistant/cli.py
    assistant/ui.py
    assistant/__init__.py

[report]
show_missing = True
skip_covered = False
exclude_lines =
    pragma: no cover
    raise NotImplementedError
    if __name__ == .__main__.:
    \.\.\.$
