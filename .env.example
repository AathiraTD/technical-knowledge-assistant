# Lime Green Technical Knowledge Assistant — example configuration
#
# Copy to .env only if you are running the Docker Compose stack: the compose
# files read it, and the application does not. There is no dotenv loader in
# this repository, so a value written here reaches a local `python -m ...` run
# only if you export it in your shell first.
#
# Do NOT commit .env — only .env.example is tracked.
#
# --------------------------------------------------------------------------
# The short version: a local interview/demo run needs NONE of this.
#
#   python -m assistant.index
#   python -m assistant.ui
#
# With nothing set, the application selects SQLite, local vector similarity,
# local Ollama, in-memory conversation state, and no hosted tracing. Every
# variable below is an override, not a requirement.
# --------------------------------------------------------------------------


# ==========================================================================
# LOCAL / INTERVIEW RUNTIME — these are the defaults, shown explicitly
# ==========================================================================
# Each line below restates what the code already does when the variable is
# unset. They are commented out for exactly that reason: setting them changes
# nothing. Uncomment only to move away from the default.

# Knowledge store. Storage is selected by ONE variable, ASSISTANT_POSTGRES_DSN
# (assistant/store/factory.py). Unset or empty — as here — means SQLite at
# data/index/knowledge.db, which is the local/interview path: no PostgreSQL,
# no pgvector, no server to start. See the production section for the other
# side of this switch.
# ASSISTANT_POSTGRES_DSN=

# Conversation state. Unset or empty means LangGraph's InMemorySaver: state
# lives in the process, does not survive a restart and is not shared between
# workers. That is the intended local behaviour. A PostgreSQL value here does
# NOT work today and is not silently ignored — it raises
# PostgresCheckpointerUnavailable, because langgraph-checkpoint-postgres 3.0.1
# requires langgraph-checkpoint<4 while langgraph 1.2.11 requires >=4.1.0.
# ASSISTANT_CHECKPOINT_DSN=

# Local model server. 127.0.0.1, not a container hostname.
# OLLAMA_HOST=http://127.0.0.1:11434

# Generation model, used for composition and structured model tasks.
# GENERATION_MODEL=qwen3.5:4b

# Embedding model and its dimensionality. Both are recorded in the index
# header: changing either means rebuilding the index, and the engine refuses
# to query an index built with a different model rather than returning
# confident nonsense.
# EMBED_MODEL=qwen3-embedding:0.6b
# EMBED_DIMENSIONS=1024

# How long Ollama keeps the model resident. 5m restores the server default;
# 0 unloads as soon as a call returns.
# OLLAMA_KEEP_ALIVE=30m

# Context window, for generation and for vision. One variable deliberately
# drives both: two different context sizes for one model are two resident
# instances in Ollama, and the second request then blocks indefinitely.
# OLLAMA_NUM_CTX=8192

# Content-addressed embedding cache. Ships with the repository so a clean
# clone indexes in seconds rather than minutes.
# ASSISTANT_EMBEDDING_CACHE=data/index/embeddings.db

# Image reading (the vision demonstration). Off unless set to 1/true/yes/on.
#
# Off is a supported state, not a broken one: an uploaded photograph is
# acknowledged and handed to a person, which is the published behaviour
# DECISIONS 16 describes. Only coverage changes.
#
# Off is the default for three reasons. Perception costs one to three minutes
# per image on a processor with no graphics card, so an accidental upload on a
# shared deployment is a denial-of-service with good intentions. The vision
# model is a separate pull an operator may not have. And a confident wrong
# visual reading remains the worst failure this system can produce, which is
# why every reading is hedged and why inside-or-outside still cannot be
# decided from an image even when this is on.
#
# Turning it on requires VISION_MODEL to be pulled in Ollama (default: the
# generation model, which must be multimodal).
# ASSISTANT_VISION_DEMO=1

# Vision model tag. Defaults to the generation model, which must then be
# multimodal. Only read when ASSISTANT_VISION_DEMO is on.
# VISION_MODEL=qwen3.5:4b

# Hosted tracing (LangSmith/LangChain) is not a variable to set here. It is
# closed in code, by assignment rather than setdefault, in
# assistant/__init__.py — so a hostile value inherited from a parent
# environment cannot switch it back on. tests/test_privacy_tracing.py proves
# that, with a control test proving the same values would enable it without
# this application.


# ==========================================================================
# PRODUCTION-ORIENTED — examples for a deployed stack, not local settings
# ==========================================================================
# Nothing below is required for, or read by, the local demo. Status of each
# capability is stated in the README's "Runtime profiles" section; do not read
# a variable's presence here as evidence that the capability is operated.

# --- PostgreSQL + pgvector (adapter implemented and contract-tested against a
# --- real database in CI; the submitted demo does not run on it) ---
#
# Setting this selects the PostgreSQL adapter at every entry point: indexer,
# CLI, UI, session store and readiness. It is the only storage switch.
# Inside Compose use the service DNS name db:5432, never localhost.
# ASSISTANT_POSTGRES_DSN=postgresql://postgres:postgres@db:5432/knowledge_assistant

# Consumed by docker-compose.yml to build the database service and the DSN
# above. Read by the application only through that DSN.
POSTGRES_DB=knowledge_assistant
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# --- Model server inside Compose (service DNS, not localhost) ---
OLLAMA_HOST=http://ollama:11434
OLLAMA_PORT=11434

# --- Application container ---
APP_PORT=8000
LOG_LEVEL=INFO
PYTHONUNBUFFERED=1

# --- OpenTelemetry export (opt-in; empty endpoint disables it) ---
# This is the only telemetry this project sanctions — see
# assistant/observability.py. Examples:
#   http://localhost:4317           (local collector)
#   https://otlp.datadoghq.com      (Datadog)
#   https://otlp-gateway-prod-us-west-0.grafana.net/otlp  (Grafana Cloud)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=technical-knowledge-assistant
OTEL_SERVICE_VERSION=1.0.0
OTEL_DEPLOYMENT_ENVIRONMENT=development
