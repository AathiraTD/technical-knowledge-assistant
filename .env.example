# Lime Green Technical Knowledge Assistant — Docker Compose Configuration
# Copy this to .env and adjust values for your deployment.
# Do NOT commit .env to version control — only .env.example should be tracked.

# PostgreSQL Configuration
POSTGRES_DB=knowledge_assistant
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Ollama Configuration
OLLAMA_HOST=http://ollama:11434
OLLAMA_PORT=11434

# Application Configuration
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Database Connection String (constructed from above)
# ASSISTANT_POSTGRES_DSN=postgresql://postgres:postgres@db:5432/knowledge_assistant

# Python Configuration
PYTHONUNBUFFERED=1
