# Lime Green Technical Knowledge Assistant — Docker Compose Configuration
# Copy this to .env and adjust values for your deployment.
# Do NOT commit .env to version control — only .env.example should be tracked.

# PostgreSQL Configuration
POSTGRES_DB=knowledge_assistant
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Ollama Configuration
OLLAMA_HOST=http://ollama:11434
OLLAMA_PORT=11434

# Application Configuration
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Database Connection String (constructed from above)
# ASSISTANT_POSTGRES_DSN=postgresql://postgres:postgres@db:5432/knowledge_assistant

# Image reading (the vision demonstration). Off unless set to 1/true/yes/on.
#
# Off is a supported state, not a broken one: an uploaded photograph is
# acknowledged and handed to a person, which is the published behaviour
# DECISIONS 16 describes. Only coverage changes.
#
# Off is the default for three reasons. Perception costs one to three minutes
# per image on a processor with no graphics card, so an accidental upload on a
# shared deployment is a denial-of-service with good intentions. The vision
# model is a separate pull an operator may not have. And a confident wrong
# visual reading remains the worst failure this system can produce, which is
# why every reading is hedged and why inside-or-outside still cannot be
# decided from an image even when this is on.
#
# Turning it on requires VISION_MODEL to be pulled in Ollama (default: the
# generation model, which must be multimodal).
# ASSISTANT_VISION_DEMO=1

# Vision model tag. Defaults to the generation model, which must then be
# multimodal. Only read when ASSISTANT_VISION_DEMO is on.
# VISION_MODEL=qwen3.5:4b

# Python Configuration
PYTHONUNBUFFERED=1

# OpenTelemetry Export (optional)
# Leave empty to disable OTLP export
# Examples:
#   http://localhost:4317           (local collector)
#   https://otlp.datadoghq.com      (Datadog)
#   https://otlp-gateway-prod-us-west-0.grafana.net/otlp  (Grafana Cloud)
OTEL_EXPORTER_OTLP_ENDPOINT=

# OpenTelemetry Service Metadata
OTEL_SERVICE_NAME=technical-knowledge-assistant
OTEL_SERVICE_VERSION=1.0.0
OTEL_DEPLOYMENT_ENVIRONMENT=development

# Optional: write logs to file (in addition to stdout)
# Example: logs/app.jsonl
OTEL_LOG_FILE=
