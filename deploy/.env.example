# Copy to deploy/.env and set a real password. Never commit deploy/.env.
POSTGRES_USER=assistant
POSTGRES_PASSWORD=change-me-before-running
POSTGRES_DB=assistant

ASSISTANT_PORT=8765

# Recorded in the index header. Changing either means rebuilding the index —
# the engine refuses to query an index built with a different embedding model.
GENERATION_MODEL=qwen3.5:4b
EMBED_MODEL=qwen3-embedding:0.6b
