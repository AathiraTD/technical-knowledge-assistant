# Configuration for the deploy/ container stack — the current one.
#
#   cp deploy/.env.example deploy/.env      # then set POSTGRES_PASSWORD
#   docker compose -f deploy/compose.yaml up -d
#
# `deploy/compose.yaml` declares no `env_file`, so Compose picks up the `.env`
# sitting next to it — this file, copied to `deploy/.env`. The repository root
# also has a `.env.example`; that one belongs to the superseded root
# `docker-compose.yml` and configures a different stack. The two are not
# interchangeable and should not be merged.
#
# Never commit `deploy/.env`. Only this example is tracked.
#
# For the full annotated list of every variable the APPLICATION reads (as
# opposed to the handful Compose needs), see the root `.env.example`.

# --- Database ----------------------------------------------------------------
# POSTGRES_PASSWORD has no default in compose (`${POSTGRES_PASSWORD:?}`), so
# `up` fails on a missing value rather than starting a database with a password
# somebody committed. Set it before the first run.
POSTGRES_USER=assistant
POSTGRES_PASSWORD=change-me-before-running
POSTGRES_DB=assistant

# --- Host port ---------------------------------------------------------------
# Published as 127.0.0.1:${ASSISTANT_PORT}:8765 — bound to the loopback
# interface, not to every interface. The container always listens on 8765
# internally; this only changes where it surfaces on the host.
ASSISTANT_PORT=8765

# --- Models ------------------------------------------------------------------
# Recorded in the index header. Changing EMBED_MODEL or EMBED_DIMENSIONS means
# rebuilding the index — the engine refuses to query an index built with a
# different embedding model rather than returning confident nonsense.
#
# EMBED_DIMENSIONS must match the model's actual vector width. It is consumed by
# compose as ${EMBED_DIMENSIONS:-1024}; it was previously absent from this file
# while compose interpolated it, which meant the only way to discover it was to
# read the compose file.
GENERATION_MODEL=qwen3.5:4b
EMBED_MODEL=qwen3-embedding:0.6b
EMBED_DIMENSIONS=1024

# --- Not set here ------------------------------------------------------------
# ASSISTANT_POSTGRES_DSN is assembled by compose from POSTGRES_USER/PASSWORD/DB
# above and points at `db:5432` — the service DNS name, never localhost, which
# inside a container is the container. Do not set it directly here.
#
# OLLAMA_HOST is likewise fixed by compose to `http://ollama:11434`.
#
# OTEL_* variables are NOT currently passed into the app container by
# `deploy/compose.yaml`, so setting them in `deploy/.env` has no effect today.
