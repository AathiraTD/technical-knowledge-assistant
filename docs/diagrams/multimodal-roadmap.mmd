flowchart TD
    classDef input fill:#fff7ed,stroke:#fb923c,color:#7c2d12,stroke-width:2px
    classDef vision fill:#f5f3ff,stroke:#a78bfa,color:#4c1d95,stroke-width:2px
    classDef data fill:#ecfeff,stroke:#22d3ee,color:#155e75,stroke-width:2px
    classDef built fill:#f0fdf4,stroke:#4ade80,color:#166534,stroke-width:2px
    classDef decision fill:#fefce8,stroke:#facc15,color:#713f12,stroke-width:2px
    classDef human fill:#fef2f2,stroke:#f87171,color:#7f1d1d,stroke-width:2px
    classDef output fill:#eef2ff,stroke:#818cf8,color:#312e81,stroke-width:2px
    classDef feedback fill:#fdf4ff,stroke:#e879f9,color:#86198f,stroke-width:2px

    USER(["Customer or trade<br/>Photo(s) · question · known details"])

    subgraph PERCEPTION["1 · Vision-assisted context — roadmap"]
        direction TB
        VLM["Vision model<br/>Qwen3-VL / Gemma or equivalent<br/><i>Reads pixels; never selects a product</i>"]
        OBS["Structured observations<br/>value · confidence · image · region<br/>plus: cannot determine from image"]
        PROFILE["Building context profile<br/>substrate · masonry · existing finish<br/>moisture · cracking · deterioration<br/>interior / exterior"]
        VLM --> OBS --> PROFILE
    end

    GATE{"Are the load-bearing facts known?<br/><i>Substrate + interior / exterior</i>"}

    ELICIT["Guided visual survey<br/>Request one specific photo or detail:<br/>exposed substrate · ground line / drainage<br/>wider elevation · non-visible facts"]

    subgraph ADVICE["2 · Evidence-based advice — built pipeline"]
        direction TB
        SLOTS["Slot detection<br/>Use confident profile values;<br/>keep uncertain facts uncued"]
        RETR["Domain retrieval<br/>Product documents · technical sheets<br/>application rules · contraindications<br/>heritage guidance"]
        ENGINE["Recommendation engine<br/>Deterministic routing → extract or compose<br/>Citation and safety checks before output"]
        SLOTS --> RETR --> ENGINE
    end

    HUMAN["Technical-team hand-off<br/>Attach photos and confidence-tagged observations<br/><i>Defect diagnosis remains a human judgement</i>"]
    OUT["Customer reply<br/>Recommendation + numbered citations<br/>assumptions and confidence<br/>unknowns + next best question"]
    LIB[("Labelled failure library<br/>Photos paired with advisor outcomes")]

    USER --> VLM
    PROFILE --> GATE
    GATE -->|"Enough evidence"| SLOTS
    GATE -->|"Need more evidence"| ELICIT
    ELICIT -.->|"One targeted photo or answer"| USER
    GATE -->|"Defect / cause assessment"| HUMAN
    ENGINE --> OUT
    HUMAN --> OUT
    HUMAN -.->|"Advisor outcome"| LIB
    LIB -.->|"Fine-tuning when sufficient pairs exist"| VLM

    class USER input
    class VLM,OBS,PROFILE vision
    class GATE decision
    class ELICIT data
    class SLOTS,RETR,ENGINE built
    class HUMAN human
    class OUT output
    class LIB feedback