flowchart TB
    classDef intake fill:#fff7ed,stroke:#fb923c,color:#7c2d12,stroke-width:2px
    classDef vision fill:#f5f3ff,stroke:#a78bfa,color:#4c1d95,stroke-width:2px
    classDef evidence fill:#ecfeff,stroke:#22d3ee,color:#155e75,stroke-width:2px
    classDef decision fill:#fefce8,stroke:#facc15,color:#713f12,stroke-width:2px
    classDef process fill:#eef2ff,stroke:#818cf8,color:#312e81,stroke-width:2px
    classDef safe fill:#f0fdf4,stroke:#4ade80,color:#166534,stroke-width:2px
    classDef handoff fill:#fef2f2,stroke:#f87171,color:#7f1d1d,stroke-width:2px
    classDef output fill:#fdf4ff,stroke:#e879f9,color:#86198f,stroke-width:2px

    subgraph INPUT["1 · Intake and building context"]
        direction TB
        IN["Question, audience and optional photo(s)<br/>Public · trade · staff · input capped at ~500 words"]
        VISION["Vision-assisted observations<br/>Substrate · coating · symptom · exposure<br/>Each observation carries a confidence"]
        CONTEXT["Building context<br/>Substrate · location · interior / exterior<br/>Masonry · finish · moisture · cracking · deterioration"]
        IN --> VISION --> CONTEXT
    end

    subgraph EVIDENCE["2 · Evidence and deterministic routing"]
        direction TB
        SPLIT["Split the question into topics<br/>Each topic is independently gated and routed"]
        POLICY{"Policy or document request?"}
        ROUTE["Fixed route or document answer<br/>Manifest-filtered by audience; no retrieval"]
        SLOTS["Slot detection<br/>Use confident context; keep unknown facts uncued<br/>State non-critical assumptions"]
        RETRIEVE["Retrieve authoritative passages<br/>Audience filter · authority ranking · newest within type"]
        ROUTER{"Deterministic answer route"}
        SPLIT --> POLICY
        POLICY -->|"No"| SLOTS --> RETRIEVE --> ROUTER
    end

    subgraph RESPONSE["3 · Grounded response and safeguards"]
        direction TB
        EXTRACT["Extract published fact<br/>Return the complete cited passage and attached caveats"]
        COMPOSE["Compose grounded answer<br/>Cited passages only; no certification, promises or brand evaluation"]
        LLM["Local LLM · Ollama<br/>Fixed model, seed and low-temperature context-only prompt"]
        CHECKS{"Citation and safety checks pass?"}
        HANDOFF["Guided hand-off or ask-back<br/>Name the missing detail, published limit or next photo needed"]
        OUT["Composite reply<br/>Answer · sources · assumptions · uncertainties · next step<br/>Diagnostics: path, chunks, sources and scores"]
        COMPOSE --> LLM --> CHECKS
        EXTRACT --> OUT
        CHECKS -->|"Pass"| OUT
    end

    CONTEXT --> SPLIT
    POLICY -->|"Yes"| ROUTE --> OUT

    ROUTER -->|"Published deferral"| HANDOFF
    ROUTER -->|"Symptom or photo diagnosis"| HANDOFF
    ROUTER -->|"Below threshold or not stated"| HANDOFF
    ROUTER -->|"Substrate unknown"| HANDOFF
    ROUTER -->|"Calculation or single-document fact"| EXTRACT
    ROUTER -->|"Otherwise"| COMPOSE
    ROUTER -->|"Interior / exterior unknown"| COMPOSE

    CHECKS -->|"Fail"| HANDOFF
    HANDOFF --> OUT

    IN -.->|"Audience set"| ROUTE
    IN -.->|"Audience set"| RETRIEVE

    class IN intake
    class VISION,CONTEXT vision
    class SPLIT,SLOTS,RETRIEVE evidence
    class POLICY,ROUTER,CHECKS decision
    class ROUTE,EXTRACT,COMPOSE process
    class LLM safe
    class HANDOFF handoff
    class OUT output